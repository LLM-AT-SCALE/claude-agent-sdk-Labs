# Never commit credentials. The labs prompt for the API key at runtime.
.env
.env.*
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Streamlit / runtime artifacts
.streamlit/secrets.toml
files/
outputs/
*.docx
!Lab-1/data/*.docx

# OS
Thumbs.db
.DS_Store

# Lab guide build artefacts.
# doc/assets holds artwork lifted from the existing bootcamp PDF, which is
# marked Confidential and Proprietary - Not for Distribution. This repo is
# public, so neither the assets nor the built PDF are committed.
Lab-1/doc/assets/
Lab-1/doc/code/
Lab-1/doc/preview*/
Lab-1/docs/preview*/
# Built guides embed artwork from the source bootcamp PDF - keep them all out,
# wherever they land. The sample loan applications in Lab-1/data are ours.
*.pdf
!Lab-1/data/*.pdf
