# ---------------------------------------------------------------- secrets --
# Never commit credentials. Every lab prompts for what it needs at run time:
# getpass in the notebook, a password field in the app. Nothing reads a .env,
# so this is the second line of defence, not the first.
.env
.env.*
*.key
*.pem
.streamlit/secrets.toml

# ----------------------------------------------------------------- python --
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --------------------------------------------------------------- notebooks --
# Colab and Jupyter both leave these behind, and they are pure noise.
.ipynb_checkpoints/
*-checkpoint.ipynb

# --------------------------------------------------------------- editors --
.vscode/
.idea/
*.swp

# -------------------------------------------------------------------- os --
Thumbs.db
.DS_Store
desktop.ini

# ------------------------------------------------------- runtime artifacts --
# Written while a lab runs. Every one is regenerated on the next run, so a
# committed copy could only ever be stale.
files/
outputs/
*.log
Lab-2/api-server.log
Lab-2/streamlit.log

# --------------------------------------------------- built guides and docs --
# The guides are build artifacts: rebuild them with the scripts in each lab's
# doc/ folder rather than committing a binary that changes on every run.
# Lab-1/doc/assets holds artwork lifted from the bootcamp PDF, which is marked
# Confidential and Proprietary - Not for Distribution, and this repo is public.
Lab-1/doc/assets/
Lab-1/doc/code/
Lab-1/doc/preview*/
Lab-1/docs/preview*/
Lab-2/doc/assets/
Lab-2/doc/code/
Lab-2/doc/preview*/
*.pdf
!Lab-1/data/*.pdf

# Word documents, except the sample loan applications Lab 1 ships as inputs.
*.docx
!Lab-1/data/*.docx

# ------------------------------------------------------- working material --
# Scratch files kept beside the repo while authoring. They are not labs, so
# they stay out of the tree that readers see. Delete these lines if you ever
# want the prompt-pack sources versioned here.
prompt-pack-source/
prompt-pack-attachments/
/*.png
/*.jpg
/*.jpeg
